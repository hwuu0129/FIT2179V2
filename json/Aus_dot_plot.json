{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 350,
  "title": {
    "text": "Daily Fire Detections in Australia (Mar–May 2026)",
    "fontSize": 15,
    "fontWeight": "bold"
  },
  "data": {
    "url": "data/Australian_fixed.csv"
  },
  "transform": [
    {
      "timeUnit": "yearmonthdate",
      "field": "acq_date",
      "as": "date"
    },
    {
      "aggregate": [
        {"op": "count", "as": "fire_count"},
        {"op": "mean",  "field": "frp", "as": "avg_frp"}
      ],
      "groupby": ["date"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#f0a050",
        "opacity": 0.4,
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Date",
          "axis": {"format": "%b %d", "labelAngle": -45}
        },
        "y": {
          "field": "fire_count",
          "type": "quantitative",
          "title": "Number of Fire Detections"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 60
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Date",
          "axis": {"format": "%b %d", "labelAngle": -45}
        },
        "y": {
          "field": "fire_count",
          "type": "quantitative",
          "title": "Number of Fire Detections"
        },
        "color": {
          "field": "avg_frp",
          "type": "quantitative",
          "title": "Avg FRP (MW)",
          "scale": {"scheme": "oranges"}
        },
        "tooltip": [
          {"field": "date",       "type": "temporal",      "title": "Date",           "format": "%Y-%m-%d"},
          {"field": "fire_count", "type": "quantitative",  "title": "Fire Detections"},
          {"field": "avg_frp",    "type": "quantitative",  "title": "Avg FRP (MW)",   "format": ".2f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"grid": false}
  }
}
