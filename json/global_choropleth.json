{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global Wildfire Activity",
    "subtitle": "VIIRS satellite fire detections, May 2026",
    "color": "#222222",
    "subtitleColor": "#666666",
    "fontSize": 20,
    "subtitleFontSize": 13
  },
  "width": 900,
  "height": 450,
  "background": "#f5f5f5",
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e0e0e0",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {"url": "data/global_fire_choropleth.csv"},
            "key": "id",
            "fields": ["fire_count", "avg_frp", "country"]
          }
        },
        {"filter": "isValid(datum.fire_count)"}
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "fire_count",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "scheme": "orangered",
            "domainMin": 1
          },
          "title": "Fire detections (log scale)",
          "legend": {
            "orient": "bottom",
            "titleColor": "#333333",
            "labelColor": "#333333",
            "gradientLength": 300
          }
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "fire_count", "type": "quantitative", "title": "Fire Count", "format": ","},
          {"field": "avg_frp", "type": "quantitative", "title": "Avg FRP (MW)", "format": ".1f"}
        ]
      }
    }
  ]
}
