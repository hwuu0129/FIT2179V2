{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Total Fire Detections by State", "subtitle": "March – May 2026 (NASA VIIRS)"},
  "width": 500,
  "height": 300,
  "data": {"url": "data/australia_fire_by_state.csv"},
  "mark": {"type": "bar", "color": "#D95F02"},
  "encoding": {
    "x": {"field": "fire_count", "type": "quantitative", "title": "Fire Detections"},
    "y": {"field": "STATE_NAME", "type": "nominal", "sort": "-x", "title": null},
    "color": {
      "condition": {"test": "datum.STATE_NAME === 'Western Australia'", "value": "#B22222"},
      "value": "#D95F02"
    },
    "tooltip": [
      {"field": "STATE_NAME", "title": "State"},
      {"field": "fire_count", "title": "Fire Count"},
      {"field": "avg_frp", "title": "Avg FRP (MW)", "format": ".1f"}
    ]
  }
}
