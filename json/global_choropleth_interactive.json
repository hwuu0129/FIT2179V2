{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global Bushfire Activity by Country",
    "subtitle": "Select a year to update the map"
  },
  "width": 800,
  "height": 400,
  "params": [
    {
      "name": "year_select",
      "value": 2024,
      "bind": {
        "input": "select",
        "options": [2020, 2021, 2022, 2023, 2024],
        "name": "Select Year: "
      }
    }
  ],
  "projection": {"type": "equalEarth"},
  "data": {
    "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
    "format": {"type": "topojson", "feature": "countries"}
  },
  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {"url": "data/global_fire_by_country_year.csv"},
        "key": "country",
        "fields": ["total_fires", "year"]
      }
    },
    {
      "filter": "datum.year == year_select"
    }
  ],
  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.3},
  "encoding": {
    "color": {
      "field": "total_fires",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "scheme": "orangered",
        "domainMin": 1
      },
      "title": "Fire Count",
      "condition": {
        "test": "!isValid(datum.total_fires)",
        "value": "#e0e0e0"
      }
    },
    "tooltip": [
      {"field": "properties.name", "type": "nominal", "title": "Country"},
      {"field": "total_fires", "type": "quantitative", "title": "Fire Count", "format": ","},
      {"field": "year", "type": "quantitative", "title": "Year"}
    ]
  }
}
