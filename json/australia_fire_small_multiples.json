
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Daily Fire Detections by State", "subtitle": "March – May 2026"},
  "data": {"url": "data/australia_fire_by_state_daily.csv"},
  "facet": {
    "field": "STATE_NAME",
    "type": "nominal",
    "columns": 3
  },
  "spec": {
    "width": 180,
    "height": 100,
    "mark": {"type": "line", "color": "#D95F02"},
    "encoding": {
      "x": {"field": "date", "type": "temporal", "title": null, "axis": {"format": "%b %d", "labelAngle": -45}},
      "y": {"field": "fire_count", "type": "quantitative", "title": "Count"},
      "tooltip": [
        {"field": "date", "type": "temporal", "title": "Date"},
        {"field": "STATE_NAME", "title": "State"},
        {"field": "fire_count", "title": "Fire Count"}
      ]
    }
  }
}
