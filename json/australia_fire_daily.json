{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Daily Bushfire Detections in Australia",
    "subtitle": "March – May 2026 (NASA VIIRS)"
  },
  "width": 700,
  "height": 300,
  "data": {
    "url": "data/australia_fire_daily.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#D95F02"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Date",
          "axis": {"format": "%b %d"}
        },
        "y": {
          "field": "fire_count",
          "type": "quantitative",
          "title": "Number of Fire Detections"
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Date", "format": "%Y-%m-%d"},
          {"field": "fire_count", "type": "quantitative", "title": "Fire Count"}
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "color": "#D95F02",
        "size": 40
      },
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"field": "fire_count", "type": "quantitative"}
      }
    },
    {
      "data": {
        "values": [
          {"date": "2026-04-15", "fire_count": 8064, "label": "Peak: 8,064"},
          {"date": "2026-05-07", "fire_count": 8154, "label": "Peak: 8,154"}
        ]
      },
      "mark": {
        "type": "text",
        "dy": -12,
        "color": "#B22222",
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"field": "fire_count", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
