{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global Wildfire Activity",
    "subtitle": "VIIRS satellite fire detections, May 2026",
    "color": "white",
    "subtitleColor": "#aaaaaa",
    "fontSize": 20,
    "subtitleFontSize": 13
  },
  "width": 900,
  "height": 450,
  "background": "#111111",
  "projection": {"type": "equalEarth"},
  "data": {
    "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
    "format": {"type": "topojson", "feature": "countries"}
  },
  "transform": [
    {
      "lookup": "id",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/lukes/ISO-3166-Countries-with-Regional-Codes/master/all/all.csv"
        },
        "key": "country-code",
        "fields": ["name"]
      }
    },
    {
      "lookup": "name",
      "from": {
        "data": {"url": "data/global_fire_choropleth.csv"},
        "key": "country",
        "fields": ["fire_count", "avg_frp"]
      }
    }
  ],
  "mark": {"type": "geoshape", "stroke": "#333333", "strokeWidth": 0.3},
  "encoding": {
    "color": {
      "field": "fire_count",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "scheme": "orangered",
        "domainMin": 1
      },
      "title": "Fire detections (log scale)",
      "legend": {
        "orient": "bottom",
        "titleColor": "white",
        "labelColor": "white",
        "gradientLength": 300
      },
      "condition": {
        "test": "!isValid(datum.fire_count)",
        "value": "#1a1a2e"
      }
    },
    "tooltip": [
      {"field": "name", "type": "nominal", "title": "Country"},
      {"field": "fire_count", "type": "quantitative", "title": "Fire Count", "format": ","},
      {"field": "avg_frp", "type": "quantitative", "title": "Avg FRP (MW)", "format": ".1f"}
    ]
  }
}
