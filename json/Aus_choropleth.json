{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 500,
  "title": {
    "text": "Fire Detections by Australian State (Mar–May 2026)",
    "fontSize": 15,
    "fontWeight": "bold"
  },
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 700
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8dcc8",
        "stroke": "#ccc",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {"filter": "datum.id == 36"},
        {
          "lookup": "id",
          "from": {
            "data": {"values": [{"id": 36, "label": "Australia"}]},
            "key": "id",
            "fields": ["label"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f5e6cc",
        "stroke": "#aaa",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/aus_states.csv"
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {"state": "Northern Territory", "lat": -19.5,  "lon": 133.4},
                {"state": "Western Australia",  "lat": -25.0,  "lon": 121.6},
                {"state": "Queensland",         "lat": -22.0,  "lon": 144.0},
                {"state": "New South Wales",    "lat": -32.0,  "lon": 146.5},
                {"state": "South Australia",    "lat": -30.0,  "lon": 135.8},
                {"state": "Victoria",           "lat": -37.0,  "lon": 144.5},
                {"state": "Tasmania",           "lat": -42.0,  "lon": 146.5}
              ]
            },
            "key": "state",
            "fields": ["lat", "lon"]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude":  {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "fire_count",
          "type": "quantitative",
          "title": "Fire Detections",
          "scale": {"range": [200, 4000]}
        },
        "color": {
          "field": "avg_frp",
          "type": "quantitative",
          "title": "Avg FRP (MW)",
          "scale": {"scheme": "oranges"}
        },
        "tooltip": [
          {"field": "state",      "type": "nominal",     "title": "State"},
          {"field": "fire_count", "type": "quantitative","title": "Fire Detections", "format": ","},
          {"field": "avg_frp",    "type": "quantitative","title": "Avg FRP (MW)",    "format": ".2f"},
          {"field": "total_frp",  "type": "quantitative","title": "Total FRP (MW)",  "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}
