{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,
  "title": {
    "text": "Top 10 Countries by Fire Detections (May 2026)",
    "fontSize": 16,
    "fontWeight": "bold"
  },
  "data": {
    "values": [
      {"country": "Australia",     "fire_count": 33372, "avg_frp": 8.89},
      {"country": "India",         "fire_count": 30019, "avg_frp": 5.78},
      {"country": "DR Congo",      "fire_count": 24746, "avg_frp": 7.83},
      {"country": "Russia",        "fire_count": 22918, "avg_frp": 9.69},
      {"country": "Mexico",        "fire_count": 19635, "avg_frp": 9.45},
      {"country": "Madagascar",    "fire_count": 14030, "avg_frp": 6.35},
      {"country": "China",         "fire_count": 12995, "avg_frp": 4.38},
      {"country": "United States", "fire_count": 9936,  "avg_frp": 6.88},
      {"country": "Venezuela",     "fire_count": 7532,  "avg_frp": 7.28},
      {"country": "Guinea",        "fire_count": 6998,  "avg_frp": 21.97}
    ]
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },
  "encoding": {
    "y": {
      "field": "country",
      "type": "nominal",
      "title": "Country",
      "sort": "-x"
    },
    "x": {
      "field": "fire_count",
      "type": "quantitative",
      "title": "Fire Detections"
    },
    "color": {
      "field": "fire_count",
      "type": "quantitative",
      "scale": {"scheme": "oranges"},
      "legend": null
    },
    "tooltip": [
      {"field": "country",    "type": "nominal",      "title": "Country"},
      {"field": "fire_count", "type": "quantitative", "title": "Fire Detections", "format": ","},
      {"field": "avg_frp",    "type": "quantitative", "title": "Avg FRP (MW)",    "format": ".2f"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    }
  }
}
