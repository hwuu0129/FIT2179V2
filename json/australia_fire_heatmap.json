{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {"text": "Monthly Fire Detections by State"},
  "width": 300,
  "height": 200,
  "data": {"url": "data/australia_fire_heatmap.csv"},
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "month", "type": "nominal",
      "sort": ["March", "April", "May"],
      "title": "Month"
    },
    "y": {"field": "STATE_NAME", "type": "nominal", "title": null},
    "color": {
      "field": "fire_count", "type": "quantitative",
      "scale": {"scheme": "orangered"},
      "title": "Fire Count"
    },
    "tooltip": [
      {"field": "STATE_NAME", "title": "State"},
      {"field": "month", "title": "Month"},
      {"field": "fire_count", "title": "Fire Count"}
    ]
  }
}
