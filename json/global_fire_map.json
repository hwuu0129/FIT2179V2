{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Global Bushfire Activity",

  "width": 1000,
  "height": 500,

  "projection": {
    "type": "equalEarth"
  },

  "layer": [

    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#e6e6e6",
        "stroke": "white"
      }
    },

    {
      "data": {
        "url": "data/global_fire.csv"
      },

      "mark": {
        "type": "circle",
        "color": "#D95F02",
        "opacity": 0.35,
        "size": 12
      },

      "encoding": {

        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "frp",
            "type": "quantitative",
            "title": "Fire Intensity"
          },
          {
            "field": "acq_date",
            "type": "nominal",
            "title": "Date"
          }
        ]
      }
    }
  ]
}
