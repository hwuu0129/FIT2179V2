{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 375,
  "height": 305,
  "title": {
    "text": "Rainfall vs Bushfire Detections (2014–2024)",
    "subtitle": [
      "Each point = one state in one year.",
      "Triangle = 2019(Black Summer). Trend lines show strong correlations."
    ],
    "fontSize": 15,
    "subtitleFontSize": 11,
    "fontWeight": "bold",
    "anchor": "middle",
    "offset": 10
  },
  "data": {
    "url": "https://hwuu0129.github.io/2179_2_2/data/australia_fire_rainfall_scatter.csv"
  },
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "opacity": 0.85, "size": 80},
      "encoding": {
        "x": {
          "field": "rainfall_mm",
          "type": "quantitative",
          "axis": {"title": "", "format": "~s"}
        },
        "y": {
          "field": "fire_count",
          "type": "quantitative",
          "axis": {"title": "", "format": "~s"}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "VIC", "QLD", "WA", "SA", "NT"],
            "range": [
              "#0072B2",
              "#CC79A7",
              "#009E73",
              "#E69F00",
              "#56B4E9",
              "#D55E00"
            ]
          },
          "legend": {
            "title": "",
            "orient": "none",
            "legendX": 72,
            "legendY": 330,
            "labelFontSize": 10,
            "titleFontSize": 10,
            "symbolSize": 60,
            "columns": 6
          }
        },
        "shape": {
          "condition": {"test": "datum.year == '2019'", "value": "triangle-up"},
          "value": "circle"
        },
        "size": {
          "condition": {"test": "datum.year == '2019'", "value": 150},
          "value": 70
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "year", "type": "ordinal", "title": "Year"},
          {
            "field": "rainfall_mm",
            "type": "quantitative",
            "title": "Rainfall (mm)",
            "format": ".1f"
          },
          {
            "field": "fire_count",
            "type": "quantitative",
            "title": "Fire Detections",
            "format": ","
          },
          {
            "field": "avg_frp",
            "type": "quantitative",
            "title": "Avg Intensity (FRP)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [{"filter": "datum.state == 'NSW'"}],
      "mark": {
        "type": "line",
        "color": "#0072B2",
        "strokeDash": [4, 3],
        "strokeWidth": 1.5,
        "opacity": 0.5
      },
      "encoding": {
        "x": {"field": "rainfall_mm", "type": "quantitative"},
        "y": {"field": "fire_count", "type": "quantitative"},
        "order": {"field": "rainfall_mm", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": "datum.state == 'SA'"}],
      "mark": {
        "type": "line",
        "color": "#56B4E9",
        "strokeDash": [4, 3],
        "strokeWidth": 1.5,
        "opacity": 0.5
      },
      "encoding": {
        "x": {"field": "rainfall_mm", "type": "quantitative"},
        "y": {"field": "fire_count", "type": "quantitative"},
        "order": {"field": "rainfall_mm", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": "datum.state == 'VIC'"}],
      "mark": {
        "type": "line",
        "color": "#CC79A7",
        "strokeDash": [4, 3],
        "strokeWidth": 1.5,
        "opacity": 0.5
      },
      "encoding": {
        "x": {"field": "rainfall_mm", "type": "quantitative"},
        "y": {"field": "fire_count", "type": "quantitative"},
        "order": {"field": "rainfall_mm", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": "datum.state == 'WA'"}],
      "mark": {
        "type": "line",
        "color": "#E69F00",
        "strokeDash": [4, 3],
        "strokeWidth": 1.5,
        "opacity": 0.5
      },
      "encoding": {
        "x": {"field": "rainfall_mm", "type": "quantitative"},
        "y": {"field": "fire_count", "type": "quantitative"},
        "order": {"field": "rainfall_mm", "type": "quantitative"}
      }
    }
  ],
  "padding": 0
}
