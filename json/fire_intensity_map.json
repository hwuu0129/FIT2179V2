{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Fire Intensity Across Australia",
  "width": 800,
  "height": 500,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "data/fire.csv"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.65
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "frp",
          "type": "quantitative",
          "title": "Fire Radiative Power",
          "scale": {
            "range": [10, 800]
          }
        },
        "color": {
          "field": "frp",
          "type": "quantitative",
          "title": "Fire Intensity",
          "scale": {
            "scheme": "reds"
          }
        },
        "tooltip": [
          {"field": "latitude", "type": "quantitative"},
          {"field": "longitude", "type": "quantitative"},
          {"field": "frp", "type": "quantitative", "title": "Fire Radiative Power"},
          {"field": "acq_date", "type": "nominal", "title": "Date"},
          {"field": "confidence", "type": "nominal", "title": "Confidence"}
        ]
      }
    }
  ]
}
