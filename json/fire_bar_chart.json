{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 360,
  "title": {
    "text": "Fire Detections by Australian State",
    "subtitle": "Northern Territory recorded the highest number of fire detections",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "data": {
    "url": "data/aus_states.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelFontSize": 12
      }
    },
    "x": {
      "field": "fire_count",
      "type": "quantitative",
      "title": "Number of fire detections",
      "axis": {
        "labelFontSize": 11,
        "titleFontSize": 12
      }
    },
    "color": {
      "field": "fire_count",
      "type": "quantitative",
      "scale": {
        "scheme": "orangered"
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "fire_count",
        "type": "quantitative",
        "title": "Fire detections"
      },
      {
        "field": "avg_frp",
        "type": "quantitative",
        "title": "Average FRP",
        "format": ".2f"
      },
      {
        "field": "total_frp",
        "type": "quantitative",
        "title": "Total FRP",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "domain": false,
      "tickColor": "#cccccc",
      "labelColor": "#333333",
      "titleColor": "#333333"
    },
    "title": {
      "font": "Arial",
      "color": "#222222"
    }
  }
}
