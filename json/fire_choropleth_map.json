{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 680,
  "height": 520,
  "title": {
    "text": "Fire Detections by Australian State",
    "subtitle": "Darker states recorded more fire detections",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 700
  },
  "data": {
    "url": "data/australia_states.geojson",
    "format": {
      "type": "geojson"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.STATE_NAME || datum.properties.STE_NAME21 || datum.properties.name || datum.properties.NAME",
      "as": "state_name"
    },
    {
      "lookup": "state_name",
      "from": {
        "data": {
          "url": "data/aus_states.csv"
        },
        "key": "state",
        "fields": ["fire_count", "avg_frp", "total_frp"]
      }
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "color": {
      "field": "fire_count",
      "type": "quantitative",
      "title": "Fire detections",
      "scale": {
        "scheme": "orangered"
      },
      "legend": {
        "orient": "right",
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },
    "tooltip": [
      {
        "field": "state_name",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "fire_count",
        "type": "quantitative",
        "title": "Fire detections"
      },
      {
        "field": "avg_frp",
        "type": "quantitative",
        "title": "Average FRP",
        "format": ".2f"
      },
      {
        "field": "total_frp",
        "type": "quantitative",
        "title": "Total FRP",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Arial",
      "color": "#222222"
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
