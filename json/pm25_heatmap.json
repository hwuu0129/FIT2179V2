{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Monthly Average PM2.5 by Station",
    "subtitle": "2024, EPA Victoria"
  },
  "width": 500,
  "height": 250,
  "data": {"url": "data/victoria_pm25_monthly.csv"},
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "month",
      "type": "nominal",
      "sort": ["January","February","March","April","May","June","July","August","September","October","November","December"],
      "title": "Month",
      "axis": {"labelAngle": -45}
    },
    "y": {"field": "location_name", "type": "nominal", "title": null},
    "color": {
      "field": "avg_pm25",
      "type": "quantitative",
      "scale": {"scheme": "orangered"},
      "title": "PM2.5 (μg/m³)"
    },
    "tooltip": [
      {"field": "location_name", "title": "Station"},
      {"field": "month", "title": "Month"},
      {"field": "avg_pm25", "title": "Avg PM2.5", "format": ".1f"}
    ]
  }
}
