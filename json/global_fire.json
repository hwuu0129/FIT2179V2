{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global Active Fire Detections by Country",
    "subtitle": "NASA VIIRS fire detections, 6–15 May 2026",
      "fontSize": 15,
    "subtitleFontSize": 11,
    "fontWeight": "bold",
    "anchor": "middle",
    "offset": 10

  },
  "width": 855,
  "height": 380,
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eeeeee",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "https://hwuu0129.github.io/2179_2_2/data/country_fire_2026_for_map.csv"
            },
            "key": "id",
            "fields": ["country", "iso_a3", "total_fire_count", "avg_frp"]
          }
        },
        {"filter": "isValid(datum.total_fire_count)"}
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
      "encoding": {
        "color": {
          "field": "total_fire_count",
          "type": "quantitative",
          "title": "",
          "scale": {"scheme": "orangered"},
          "legend": {
            "format": "~s",
            "orient": "none",
            "legendX": 310,
            "legendY": 390,
            "direction": "horizontal",
            "gradientLength": 260,
            "gradientThickness": 12,
            "labelFontSize": 10,
            "title": null
          }
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "iso_a3", "type": "nominal", "title": "ISO code"},
          {
            "field": "total_fire_count",
            "type": "quantitative",
            "title": "Fire detections",
            "format": ","
          },
          {
            "field": "avg_frp",
            "type": "quantitative",
            "title": "Average FRP",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "title": {"fontSize": 16, "subtitleFontSize": 12},
    "legend": {
      "labelFontSize": 10,
      "titleFontSize": 10,
      "orient": "bottom",
      "symbolSize": 60,
      "offset": 8,
      "columns": 4
    }
  },
  "padding": 0,
  "background": "#f7f5f0"
}
