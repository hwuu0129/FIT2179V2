{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 20 Countries by Bushfire Activity",
    "subtitle": "Based on high-confidence fire detections (NASA VIIRS, 2026)",
      "fontSize": 15,
    "subtitleFontSize": 11,
    "fontWeight": "bold",
    "anchor": "middle",
    "offset": 10

  },
  "width": 320,
  "height": 335,
  "data": {
    "url": "https://hwuu0129.github.io/2179_2_2/data/global_fire_by_country.csv"
  },
  "mark": {
    "type": "bar",
    "color": "#D95F02"
  },
  "encoding": {
    "x": {
      "field": "fire_count",
      "type": "quantitative",
      "title": ""
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "color": {
      "condition": {
        "test": "datum.country === 'Australia'",
        "value": "#B22222"
      },
      "value": "#D95F02"
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "fire_count",
        "type": "quantitative",
        "title": "Fire Detections"
      }
    ]
  },
  "padding": 0
}
