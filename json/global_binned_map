{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global Bushfire Activity by Year",
    "subtitle": "Each cell shows fire count in a 1° grid square (2020–2024)"
  },
  "data": {"url": "data/global_binned_all_years.csv"},
  "facet": {
    "field": "year",
    "type": "ordinal",
    "header": {"title": null},
    "columns": 3
  },
  "spec": {
    "width": 280,
    "height": 140,
    "layer": [
      {
        "data": {
          "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
          "format": {"type": "topojson", "feature": "countries"}
        },
        "mark": {
          "type": "geoshape",
          "fill": "#e8e8e8",
          "stroke": "white",
          "strokeWidth": 0.3
        },
        "projection": {"type": "equalEarth"}
      },
      {
        "mark": {"type": "rect", "opacity": 0.85},
        "projection": {"type": "equalEarth"},
        "encoding": {
          "longitude": {"field": "lon_bin", "type": "quantitative"},
          "latitude": {"field": "lat_bin", "type": "quantitative"},
          "color": {
            "field": "fire_count",
            "type": "quantitative",
            "scale": {
              "type": "log",
              "scheme": "orangered"
            },
            "title": "Fire Count (log)"
          },
          "tooltip": [
            {"field": "year", "title": "Year"},
            {"field": "lat_bin", "title": "Latitude"},
            {"field": "lon_bin", "title": "Longitude"},
            {"field": "fire_count", "title": "Fire Count"},
            {"field": "avg_frp", "title": "Avg FRP (MW)", "format": ".1f"}
          ]
        }
      }
    ]
  }
}
